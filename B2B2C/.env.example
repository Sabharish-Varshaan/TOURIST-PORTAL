# Tourist app (incident management) backend — used for login, profile, e-KYC, check-in
NEXT_PUBLIC_TOURIST_APP_API=http://localhost:8000

# Optional: same value as GuardianID backend METRICS_API_KEY — B2B2C reports route timing to /api/metrics/ingest
# METRICS_API_KEY=

# Optional: tourist app frontend URL (for e-KYC link from dashboard)
NEXT_PUBLIC_TOURIST_APP_URL=http://localhost:3000

# OpenTripMap — real itinerary (POIs), hotels (accommodations), restaurants (foods)
# API docs don't mention the key. Get it: go to https://dev.opentripmap.org/ → Register/Sign in → copy API key from your account.
OPENTRIPMAP_API_KEY=

# Optional: external booking APIs (replace mock responses in app/api/book/*)
# EXTERNAL_TRANSPORT_API_URL=
# EXTERNAL_HOTELS_API_URL=
# EXTERNAL_RESTAURANTS_API_URL=
AMADEUS_API_KEY=
AMADEUS_API_SECRET=